<?xml version="1.0" encoding="UTF-8"?>
<!-- Mirror of a Maven Central artifact, for offline resolution tests.
     Declares no <groupId> of its own: it inherits it, like the real
     spring-boot-starter-parent does. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example.platform</groupId>
    <artifactId>platform-dependencies</artifactId>
    <version>3.4.0</version>
  </parent>
  <artifactId>platform-starter-parent</artifactId>
  <packaging>pom</packaging>
  <scm>
    <url>https://github.com/example-platform/platform</url>
  </scm>
</project>
